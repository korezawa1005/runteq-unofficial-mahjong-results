{
  "name": "runteq-unofficial-mahjong-results",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' -v && node --test tests/test_stats.js",
    "test:e2e": "node tests/e2e.mjs",
    "test:admin": "node tests/admin-e2e.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.33.1"
  }
}
